{
  "$schema": "https://json.schemastore.org/staticwebapp.config.json",
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": [
      "/assets/*",
      "/financials/*",
      "/fleet/*",
      "/videos/*",
      "/*.{png,jpg,jpeg,gif,svg,ico,webp,avif,pdf,mp4,webm,webmanifest,json,txt,xml}"
    ]
  },
  "mimeTypes": {
    ".mp4": "video/mp4"
  }
}
